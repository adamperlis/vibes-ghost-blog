{{!-- 
  Breadcrumb Schema for improved navigation understanding
  Shows site hierarchy in search results
--}}

{{#post}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{@site.url}}"
    },
    {{#primary_tag}}
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{name}}",
      "item": "{{url absolute="true"}}"
    },
    {{/primary_tag}}
    {
      "@type": "ListItem",
      "position": {{#primary_tag}}3{{else}}2{{/primary_tag}},
      "name": "{{title}}",
      "item": "{{url absolute="true"}}"
    }
  ]
}
</script>
{{/post}}

{{#is "tag"}}
{{#tag}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{@site.url}}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{name}}",
      "item": "{{url absolute="true"}}"
    }
  ]
}
</script>
{{/tag}}
{{/is}}

{{#is "author"}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{@site.url}}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Authors",
      "item": "{{@site.url}}/authors/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{primary_author.name}}",
      "item": "{{primary_author.url}}"
    }
  ]
}
</script>
{{/is}}

